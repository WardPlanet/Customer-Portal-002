# Copy this file to .env and fill it in. .env is git-ignored; never commit a real key.
# Real environment variables (for example from the host or a secrets store) override this file.

# Required for the AI features. Without it the editor still works and the AI buttons stay greyed out.
ANTHROPIC_API_KEY=

# Port the server listens on (default 3000)
PORT=3000

# Where saved drafts are stored (default: the drafts folder next to server.js).
# Point this at a persistent, backed-up location when hosting.
# DRAFTS_DIR=/var/lib/page-editor/drafts

# Models used for AI suggestions and for search keywords (default: claude-opus-5-5 for both)
# AI_MODEL=claude-opus-5-5
# AI_MODEL_QUICK=claude-opus-5-5
