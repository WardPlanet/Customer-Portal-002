# Copy this file to .env and fill it in. .env is git-ignored; never commit a real key.
# Real environment variables (for example from the host or a secrets store) override this file.

# Required for the AI features. Without it the editor still works and the AI buttons stay greyed out.
ANTHROPIC_API_KEY=

# Port the server listens on (default 3000)
PORT=3000

# Where saved drafts are stored (default: the drafts folder next to server.js).
# Point this at a persistent, backed-up location when hosting.
# DRAFTS_DIR=/var/lib/page-editor/drafts
# TEAMS_DIR=/var/lib/page-editor/teams

# Models used for AI suggestions and for search keywords (default: claude-opus-5-5 for both)
# AI_MODEL=claude-opus-5-5
# AI_MODEL_QUICK=claude-opus-5-5

# Sign-in through the company's proxy (Microsoft Entra ID). When this is set the server ignores the browser's "Acting as" choice and trusts the
# signed-in email the proxy puts in this header (see auth.js). Only turn it on when the server can be reached ONLY through the proxy, and the proxy
# removes any copy of the header the browser sends. Leave it unset for the prototype's "Acting as" menu.
# TRUSTED_EMAIL_HEADER=X-Forwarded-Email
# TRUSTED_NAME_HEADER=X-Forwarded-User
# TRUSTED_PROXY_IPS=10.0.0.5

# AI_RATE_LIMIT      most AI requests a minute for one person (default 60; a batch import uses several for each document)
# AI_RATE_LIMIT=60
